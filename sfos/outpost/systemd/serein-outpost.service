[Unit]
Description=Serein Outpost G0 independent coordinator
# PRO-132 G0: unavailable Host evidence denies admission, not observation.
After=local-fs.target

[Service]
Type=simple
NotifyAccess=main
# Current-boot signed witness, not elapsed time or process-active, proves readiness.
# Recover only this observer through the same generation-validating launcher.
# A deliberate stop remains stopped. Restart grants no domain admission and
# does not change the generation selector or retained state.
Restart=on-failure
User=serein-outpost
Group=serein-outpost
Environment=PYTHONDONTWRITEBYTECODE=1
# Preserve the existing VM4010 unprivileged generation-launcher road.
# No privileged prefix, selector permission change or credential loading.
ExecStart=/usr/libexec/serein/outpost-generation-launcher outpost/service.py --host-vitality-root /var/lib/serein-outpost/host-vitality
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=serein-outpost/coordinator serein-outpost/watchdog serein-outpost/vitals-producers serein-outpost/recovery
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=serein-outpost.target
