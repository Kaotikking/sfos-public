[Unit]
Description=Serein Outpost signed Debian Host and GPU witness
Wants=network-online.target
After=network-online.target local-fs.target
Before=serein-outpost-presentation.service

[Service]
Type=oneshot
User=serein-outpost
Group=serein-outpost
ExecStart=/usr/bin/python3 -m outpost.host_witness_runner --state-root /var/lib/serein-outpost/host-vitality
Environment=PYTHONPATH=/usr/share/serein/outpost
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=serein-outpost
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/serein-outpost
RestrictAddressFamilies=AF_INET AF_INET6
