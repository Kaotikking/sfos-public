[Unit]
Description=Serein Outpost independent witness and Serein Vitals
# Recovery observability is available independently of Host admission and Serein.
Requires=serein-outpost.service serein-outpost-presentation.service serein-https-gateway-adapter.service
After=serein-outpost.service serein-outpost-presentation.service serein-https-gateway-adapter.service
Wants=serein-outpost-host-witness.service

[Install]
WantedBy=multi-user.target
