#!/usr/bin/python3 -I
import argparse,socket,sys
from pathlib import Path
# Load only the new Authority modules, never the preserved legacy package
# initializer (which imports Companion code). The native installed layout is
# fixed; isolated Python ignores caller-controlled PYTHONPATH/user packages.
sys.dont_write_bytecode=True
sys.path.insert(0,str(Path(__file__).absolute().parents[2]/'lib/python3/dist-packages/serein_stage1'))
from kernel_branch_api import serve_authority
p=argparse.ArgumentParser();p.add_argument("--branch",choices=("AUTHORITY",),required=True);a=p.parse_args()
listener=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM,0,fileno=3);connection,_=listener.accept()
with connection:
 serve_authority(connection)

