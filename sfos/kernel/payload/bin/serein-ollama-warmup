#!/usr/bin/python3
"""Preload the pinned Serein model through Ollama's loopback API."""

from __future__ import annotations

import json
import urllib.request


ENDPOINT = "http://127.0.0.1:11434/api/generate"
MODEL = "qwen3:4b-instruct"
MAX_RESPONSE_BYTES = 1_048_576


def main() -> int:
    payload = json.dumps(
        {
            "model": MODEL,
            "prompt": "",
            "stream": False,
            "keep_alive": -1,
            "options": {"num_ctx": 8192},
        },
        separators=(",", ":"),
    ).encode("utf-8")
    request = urllib.request.Request(
        ENDPOINT,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    # Completion is established by the bounded response, not elapsed time.
    # A real transport/protocol failure is terminal; never replay the preload
    # after an ambiguous response or retry malformed output indefinitely.
    with urllib.request.urlopen(request, timeout=None) as response:
        raw = response.read(MAX_RESPONSE_BYTES + 1)
        if response.status != 200 or not 0 < len(raw) <= MAX_RESPONSE_BYTES:
            raise RuntimeError("warmup_response_invalid")
        value = json.loads(raw)
    if (
        not isinstance(value, dict)
        or value.get("model") != MODEL
        or value.get("done") is not True
    ):
        raise RuntimeError("warmup_response_invalid")
    print("SEREIN_OLLAMA_WARMUP_READY model=qwen3:4b-instruct")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
