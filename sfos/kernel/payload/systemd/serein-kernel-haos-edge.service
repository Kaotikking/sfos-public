[Unit]
Description=Serein Kernel HAOS canonical HTTPS edge
Requires=serein-kernel-client-gateway-haos.socket
After=serein-kernel-client-gateway-haos.socket
[Service]
Type=simple
User=serein-stage1
Group=serein-stage1
Environment=SEREIN_HAOS_BIND_ADDRESS=127.0.0.1
Environment=SEREIN_HAOS_BIND_PORT=8444
LoadCredential=haos-companion-token:/etc/serein/credentials/haos-companion-token
LoadCredential=serein-backend-cert.pem:/etc/serein/credentials/serein-backend-cert.pem
LoadCredential=serein-backend-key.pem:/etc/serein/credentials/serein-backend-key.pem
ExecStart=/usr/lib/serein/kernel/bin/serein-kernel-haos-edge
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX
[Install]
# Deliberately not enabled by the first install; Outpost commissions it.
