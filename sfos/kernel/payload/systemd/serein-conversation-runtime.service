[Unit]
Description=Serein Kernel companion conversation runtime
Requires=serein-conversation-runtime.socket
After=serein-kernel-interface-api.socket
[Service]
Type=notify
User=serein-stage1
Group=serein-stage1
ExecStart=/usr/libexec/serein/serein-conversation-runtime
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
