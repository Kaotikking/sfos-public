[Unit]
Description=Serein Kernel Operations queue and replay observation
Requires=serein-kernel-authority-api.socket serein-observation-audit.socket
After=serein-kernel-authority-api.socket serein-observation-audit.socket serein-observation-audit.service

[Service]
Type=simple
User=serein-stage1
Group=serein-stage1
StateDirectory=serein/kernel/replay
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/libexec/serein/serein-kernel-operations-heartbeat
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
