[Unit]
Description=Serein Kernel private replay store
After=local-fs.target

[Service]
Type=simple
User=serein-stage1
Group=serein-stage1
EnvironmentFile=/etc/serein/kernel/replay-peer.env
ExecStart=/usr/bin/python3 /usr/lib/serein/kernel/persistent_replay_store.py /var/lib/serein/kernel/replay/receipts.sqlite3 /var/lib/serein/kernel/authority/replay-descriptor.json /var/lib/serein/kernel/authority/replay.key /run/serein/kernel/replay-store.sock ${SEREIN_GATEWAY_UID} ${SEREIN_GATEWAY_GID}
RuntimeDirectory=serein/kernel
RuntimeDirectoryMode=0750
StateDirectory=serein/kernel/replay
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
